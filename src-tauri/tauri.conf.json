{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteForge",
  "mainBinaryName": "noteforge",
  "version": "0.1.0",
  "identifier": "io.github.siyana_code.NoteForge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteForge",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Local-first Markdown knowledge manager",
    "longDescription": "NoteForge is a local-first Markdown knowledge manager with wikilinks, backlinks, tags, full-text search, live preview and a graph view of your notes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
